<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/user_nav"
    app:startDestination="@id/userFragment">

    <fragment
        android:id="@+id/userFragment"
        android:name="com.maad.jobmarket.ahasan.ui.screens.UserFragment"
        android:label="fragment_user"
        tools:layout="@layout/fragment_user" >
        <action
            android:id="@+id/action_userFragment_to_userEditFragment"
            app:destination="@id/userEditFragment" />
        <action
            android:id="@+id/action_userFragment_to_userTpoContact"
            app:destination="@id/userTpoContact" />
        <action
            android:id="@+id/action_userFragment_to_userResumeEdit"
            app:destination="@id/userResumeEdit" />
    </fragment>
    <fragment
        android:id="@+id/userTpoContact"
        android:name="com.maad.jobmarket.ahasan.ui.screens.UserTpoContact"
        android:label="fragment_user_tpo_contact"
        tools:layout="@layout/fragment_user_tpo_contact" />
    <fragment
        android:id="@+id/userEditFragment"
        android:name="com.maad.jobmarket.ahasan.ui.screens.UserEditFragment"
        android:label="fragment_user_edit"
        tools:layout="@layout/fragment_user_edit">
        <argument
            android:name="student"
            app:argType="com.maad.jobmarket.ahasan.data.model.Student" />
    </fragment>
    <fragment
        android:id="@+id/userResumeEdit"
        android:name="com.maad.jobmarket.ahasan.ui.screens.UserResumeEdit"
        android:label="fragment_user_resume_edit"
        tools:layout="@layout/fragment_user_resume_edit" />
</navigation>