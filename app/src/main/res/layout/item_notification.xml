<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:clipToPadding="false">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="2dp"
        android:layout_marginTop="16dp"
        android:clipToOutline="true"
        tools:targetApi="31">

        <TextView
            android:id="@+id/nfTittle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/congratulations"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/light_orange"/>

        <TextView
            android:id="@+id/nfMassage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/you_have_been_selected_for_this_job_at_wipro_please_check_your_email_for_further_instructions"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:textColor="#555"/>

        <TextView
            android:id="@+id/nfTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_19_seconds_ago"
            android:textSize="12sp"
            android:textColor="#AAA"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

</androidx.cardview.widget.CardView>
